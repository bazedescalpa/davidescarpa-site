---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
---

<Layout 
  title="Contatti e Prenotazioni | Ayuwellness Cagliari e Villasimius" 
  description="Contatta Federica Ennas per prenotare un massaggio ayurvedico a Cagliari o il servizio a domicilio a Villasimius. Chiama o scrivi su WhatsApp."
>
  <Header />

  <main>
    <section class="page-header">
      <div class="container">
        <span class="sub-badge">Parliamo di benessere</span>
        <h1>Contatti</h1>
        <p class="subtitle">Sia a Cagliari che a Villasimius, siamo a tua disposizione per informazioni, consulenze e prenotazioni.</p>
      </div>
    </section>

    <section class="section">
      <div class="container contacts-layout">
        
        <!-- Sezione Informazioni e Mappe -->
        <div class="contact-info">
          <h2>I nostri recapiti</h2>
          <p>Puoi contattarci telefonicamente o tramite WhatsApp per fissare il tuo appuntamento o concordare un servizio speciale.</p>
          
          <div class="maps-grid">
            <!-- Studio Cagliari -->
            <div class="info-card">
              <div class="card-header-content">
                <h3>Studio Cagliari (Inverno)</h3>
                <p>Via Basilicata, 61 - 09049 Cagliari (CA)</p>
              </div>
              
              <div class="map-container">
                <iframe 
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3090.5761195967484!2d9.11096277662548!3d39.22979167165489!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12e735655dae228f%3A0xa96f35b789b7e20b!2sAyuwellness%20Lusso%20per%20la%20mente%20Olistic%20studio!5e0!3m2!1sit!2sit!4v1790583896448!5m2!1sit!2sit" 
                  width="100%" 
                  height="320" 
                  style="border:0;" 
                  allowfullscreen="" 
                  loading="lazy" 
                  referrerpolicy="no-referrer-when-downgrade"
                  title="Mappa Studio Cagliari"
                ></iframe>
              </div>
            </div>

            <!-- Villasimius & Costa Rei -->
            <div class="info-card">
              <div class="card-header-content">
                <h3>Villasimius & Costa Rei (Estate)</h3>
                <p>Servizio di massaggio a domicilio attivo nella costa sud-orientale.</p>
              </div>
              
              <div class="map-container">
                <iframe 
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3094.395675446996!2d9.516684476622135!3d39.14298127167267!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12e0c34952463e43%3A0x5daf5e880379ed84!2sAyuwellness!5e0!3m2!1sit!2sit!4v1791961702728!5m2!1sit!2sit" 
                  width="100%" 
                  height="320" 
                  style="border:0;" 
                  allowfullscreen="" 
                  loading="lazy" 
                  referrerpolicy="no-referrer-when-downgrade"
                  title="Mappa Villasimius"
                ></iframe>
              </div>
            </div>
          </div>
        </div>

        <!-- Sezione Prenota Subito -->
        <div class="contact-cta-box">
          <h3>Prenota Subito</h3>
          <p>Il modo più rapido per concordare data e orario del tuo trattamento è chiamare direttamente o scriverci un messaggio.</p>
          <div class="buttons-stack">
            <a href="tel:+393270567128" class="btn-primary">
              Chiama il <span class="phone-number">+39 327 056 7128</span>
            </a>
            <a href="https://wa.me/393270567128" target="_blank" rel="noopener noreferrer" class="btn-whatsapp">Scrivi su WhatsApp</a>
          </div>
        </div>

      </div>
    </section>
  </main>

  <Footer />
  <MobileActionBar lang="it" />
</Layout>

<style>
  /* SFONDO BIANCO PURO PER LA PAGINA */
  main {
    background-color: #ffffff !important;
  }

  .page-header {
    padding: 5rem 0 3rem 0;
    text-align: center;
    background-color: transparent;
  }

  .sub-badge {
    display: inline-block;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 2px;
    color: var(--accent);
    margin-bottom: 1rem;
    font-weight: 600;
  }

  /* TITOLO PRINCIPALE CON IL COLORE #c4a724 */
  .page-header h1 {
    font-size: clamp(2.5rem, 4vw, 3rem);
    margin-bottom: 0.5rem;
    color: #c4a724 !important;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .section {
    padding: 4rem 0 6rem 0;
    background-color: transparent;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .contacts-layout {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* TITOLI INTERNI CON IL COLORE #c4a724 */
  .contact-info h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
    color: #c4a724 !important;
  }

  .contact-info > p {
    color: var(--text-muted);
    margin-bottom: 2.5rem;
    font-size: 1.05rem;
  }

  .maps-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: stretch;
  }

  /* INFO CARD SENZA BORDI E CON ANGOLI ARROTONDATI */
  .info-card {
    background-color: #faf8f5;
    padding: 2.5rem;
    border-radius: 20px;
    box-shadow: 0 20px 40px rgba(44, 42, 41, 0.04);
    border: none !important;
    display: flex;
    flex-direction: column;
  }

  .card-header-content {
    margin-bottom: 1.25rem;
  }

  .info-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--text-main);
  }

  .card-header-content p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .map-container {
    margin-top: auto;
    border-radius: 12px;
    overflow: hidden;
    border: none !important;
  }

  /* CONTACT CTA BOX COORDINATO */
  .contact-cta-box {
    background-color: var(--accent-light);
    padding: 4rem 2rem;
    border-radius: 20px;
    text-align: center;
    max-width: 800px;
    margin: 2rem auto 0 auto;
    width: 100%;
    border: none !important;
    box-shadow: none !important;
  }

  .contact-cta-box h3 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
    color: var(--text-main);
  }

  .contact-cta-box p {
    color: var(--text-muted);
    margin-bottom: 2rem;
    font-size: 1.1rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .buttons-stack {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
  }

  .btn-primary, .btn-whatsapp {
    padding: 0.9rem 2.5rem;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.5px;
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .btn-primary:hover, .btn-whatsapp:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    background-color: var(--accent);
    color: #fff;
    box-shadow: 0 4px 15px rgba(163, 139, 116, 0.2);
  }

  .btn-whatsapp {
    background-color: #25D366;
    color: #fff;
    box-shadow: 0 4px 15px rgba(37, 211, 102, 0.2);
  }

  /* GESTIONE DELLA RIGA SPEZZATA PER IL NUMERO SU MOBILE */
  .phone-number {
    display: inline;
  }

  @media (max-width: 900px) {
    .maps-grid {
      grid-template-columns: 1fr;
    }
    .buttons-stack {
      flex-direction: column;
      gap: 1rem;
    }
    
    /* Riduce leggermente l'altezza su schermi piccolissimi se serve, oppure lascia a 320px */
    .map-container iframe {
      height: 280px;
    }

    /* Forza il numero ad andare a capo pulito su schermi piccoli */
    .btn-primary .phone-number {
      display: block;
      margin-top: 0.2rem;
      font-size: 1.05rem;
      letter-spacing: 1px;
    }
  }
</style>