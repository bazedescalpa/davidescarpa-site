---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Davide Scarpa | Soluzioni Web">
	
	<!-- SFUMATURA DI LUCE DI SFONDO (GLOW EFFECT) -->
	<!-- 
	  MODIFICA APPLICATA:
	  - Aggiunto left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen
	  Questo "strappa" letteralmente il contenitore da qualsiasi limite imposto dai tag padri,
	  costringendo il colore bg-slate-950 a stendersi da un bordo all'altro del monitor.
	-->
	<!-- Il contenitore principale in index.astro -->
    <div class="relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen overflow-hidden">
		
		<!-- Sfumature assolute posizionate sullo sfondo -->
		<div class="absolute top-0 left-1/4 -translate-x-1/2 w-[500px] h-[500px] bg-cyan-500/10 rounded-full blur-[120px] pointer-events-none"></div>
		<div class="absolute top-32 left-1/3 w-[400px] h-[400px] bg-blue-500/5 rounded-full blur-[100px] pointer-events-none"></div>

		<!-- 
		  Questo contenitore interno, invece, rimane centrato e limitato a max-w-7xl 
		  per tenere i tuoi testi perfettamente allineati alla navbar e alla Hero.
		-->
		<div class="max-w-7xl mx-auto px-6 md:px-12">
				
			<!-- 2. HERO SECTION -->
<section class="relative w-screen left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] min-h-screen bg-transparent text-white flex items-center overflow-hidden pt-16 m-0 p-0">
    
    <!-- Contenuto della Hero -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 w-full grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
            <!-- Testo Eyebrow -->
            <span class="text-cyan-400 text-sm font-semibold tracking-wider uppercase block">Creazioni Digitali Personalizzate</span>
            
            <!-- H1 -->
            <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight leading-tight">
                Sviluppo Web su Misura, <span class="bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent">Ottimizzato SEO</span> e Mobile-First per Scalare Google.
            </h1>
            
            <!-- P ottimizzato -->
            <p class="text-slate-400 text-lg max-w-md">
                Siti web d'avanguardia, applicazioni mobile e architetture scalabili, ingegnerizzati per dominare il mercato, massimizzare le conversioni e garantire velocità estreme.
            </p>
            
            <div class="pt-4">
                <a href="#contatti" class="inline-block px-6 py-3.5 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold rounded-xl shadow-lg shadow-cyan-500/20 transition-all duration-200 hover:-translate-y-0.5">
                    Inizia il tuo progetto
                </a>
            </div>
        </div>
    </div>
</section>

			<!-- 3. SERVIZI -->
<section id="servizi" class="relative py-24 px-6">
    
    <!-- Contenitore "Cono Tronco": Effetto sollevamento prospettico -->
    <div class="max-w-7xl mx-auto rounded-[3rem] 
                bg-gradient-to-b from-slate-900/40 to-slate-950/60 
                border-t border-white/10 
                shadow-[0_40px_80px_-20px_rgba(0,0,0,0.9)]">
        
        <!-- Contenitore interno: Glassmorphism puro -->
        <div class="relative rounded-[3rem] p-8 md:p-16 bg-slate-950/20 backdrop-blur-xl">
            
            <!-- Contenuto principale -->
            <div class="relative z-10">
                
                <!-- Intestazione Sezione -->
                <div class="mb-20 max-w-2xl md:ml-auto md:text-right">
                    <span class="text-cyan-400 text-sm font-semibold tracking-wider uppercase block mb-2">Competenze & Soluzioni</span>
                    <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white mb-4">Cosa Faccio</h2>
                    <p class="text-slate-400 text-lg leading-relaxed">
                        Soluzioni tecniche d'avanguardia e strategie digitali mirate per far crescere la tua attività.
                    </p>
                </div>
                
                <!-- Griglia dei Servizi -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 relative z-10">
                    
                    <!-- Card 1 -->
                    <div class="relative p-8 rounded-3xl bg-white/5 backdrop-blur-sm transition-all duration-500 hover:-translate-y-2 hover:bg-white/10 hover:shadow-[0_20px_40px_-15px_rgba(6,182,212,0.3)] group">
                        <div class="w-14 h-14 rounded-2xl bg-cyan-500/10 flex items-center justify-center text-cyan-400 mb-6 group-hover:bg-cyan-500 group-hover:text-slate-950 transition-all">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
                            </svg>
                        </div>
                        <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-cyan-400 transition-colors">Sviluppo Web</h3>
                        <p class="text-slate-400 text-sm md:text-base leading-relaxed">
                            Siti vetrina e applicazioni web moderne, veloci e ottimizzate per i motori di ricerca (SEO). Architetture pulite per garantire caricamenti istantanei e massima usabilità.
                        </p>
                    </div>

                    <!-- Card 2 -->
                    <div class="relative p-8 rounded-3xl bg-white/5 backdrop-blur-sm transition-all duration-500 hover:-translate-y-2 hover:bg-white/10 hover:shadow-[0_20px_40px_-15px_rgba(59,130,246,0.3)] group">
                        <div class="w-14 h-14 rounded-2xl bg-blue-500/10 flex items-center justify-center text-blue-400 mb-6 group-hover:bg-blue-500 group-hover:text-slate-950 transition-all">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
                            </svg>
                        </div>
                        <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors">Applicazioni Mobile</h3>
                        <p class="text-slate-400 text-sm md:text-base leading-relaxed">
                            Creazione di applicazioni native e cross-platform per iOS e Android. Interfacce utente curate, gestione fluida dello stato ed efficaci logiche di fidelizzazione.
                        </p>
                    </div>

                    <!-- Card 3 -->
                    <div class="relative p-8 rounded-3xl bg-white/5 backdrop-blur-sm transition-all duration-500 hover:-translate-y-2 hover:bg-white/10 hover:shadow-[0_20px_40px_-15px_rgba(99,102,241,0.3)] group">
                        <div class="w-14 h-14 rounded-2xl bg-indigo-500/10 flex items-center justify-center text-indigo-400 mb-6 group-hover:bg-indigo-500 group-hover:text-slate-950 transition-all">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 3h13.5m-13.5-6h13.5m-13.5-3h13.5m-13.5-3h13.5m-13.5 15h13.5M3 5.25a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 5.25v13.5a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 18.75V5.25z" />
                            </svg>
                        </div>
                        <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-indigo-400 transition-colors">Full-Stack & Cloud</h3>
                        <p class="text-slate-400 text-sm md:text-base leading-relaxed">
                            Integrazione di database in tempo reale, sistemi di autenticazione sicuri e infrastrutture cloud scalabili (come Firebase) per gestire flussi e logiche di business complesse.
                        </p>
                    </div>

                    <!-- Card 4 -->
                    <div class="relative p-8 rounded-3xl bg-white/5 backdrop-blur-sm transition-all duration-500 hover:-translate-y-2 hover:bg-white/10 hover:shadow-[0_20px_40px_-15px_rgba(168,85,247,0.3)] group">
                        <div class="w-14 h-14 rounded-2xl bg-purple-500/10 flex items-center justify-center text-purple-400 mb-6 group-hover:bg-purple-500 group-hover:text-slate-950 transition-all">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10.34 15.84c-.68-.34-1.44-.54-2.24-.54H5a3 3 0 00-3 3v.5c0 .28.22.5.5.5h6.34a2.25 2.25 0 011.5 1.66l.34 1.34a1.125 1.125 0 002.2 0l.34-1.34a2.25 2.25 0 011.5-1.66h2.12a2.25 2.25 0 002.25-2.25v-1.12a2.25 2.25 0 00-2.25-2.25H16.5a2.25 2.25 0 01-2.24-2.24V7.5a2.25 2.25 0 00-2.25-2.25h-.76a2.25 2.25 0 00-2.25 2.25v6.59c0 .6-.24 1.18-.66 1.6l-.3.3" />
                            </svg>
                        </div>
                        <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-purple-400 transition-colors">Social Media Management</h3>
                        <p class="text-slate-400 text-sm md:text-base leading-relaxed">
                            Pianificazione strategica e gestione dei canali social aziendali. Creazione di contenuti mirati per aumentare la brand awareness, connettersi con il pubblico e generare lead qualificati.
                        </p>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

			<!-- 4. PROGETTI (PORTFOLIO) -->
<section id="progetti" class="relative py-32 text-white w-full">
    
    <!-- Sfondo "vetro" a tutta larghezza con maschera di dissolvenza verticale -->
    <div class="absolute top-0 z-0 h-full w-screen left-1/2 -translate-x-1/2 bg-white/[0.02] backdrop-blur-[2px] border-y border-white/5 shadow-2xl [mask-image:linear-gradient(to_bottom,transparent,black_10%,black_90%,transparent)]">
        <div class="absolute inset-0 bg-gradient-to-b from-white/[0.03] to-transparent"></div>
    </div>
    
    <!-- Contenitore del contenuto -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 w-full">
        
        <!-- Intestazione Sezione -->
        <div class="mb-20 max-w-2xl">
            <span class="text-cyan-400 text-sm font-semibold tracking-wider uppercase block mb-2">Portfolio</span>
            <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white mb-4">Progetti in Evidenza</h2>
            <p class="text-slate-400 text-lg leading-relaxed">
                Una selezione di software, applicazioni e piattaforme digitali che ho progettato e sviluppato.
            </p>
        </div>
        
        <!-- Griglia dei Progetti -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative z-10">
            
            <!-- Card 1: Puppyon -->
            <div class="relative rounded-3xl p-8 backdrop-blur-md bg-slate-950/40 border border-white/5 shadow-[0_15px_35px_-15px_rgba(0,0,0,0.6)] transition-all duration-500 ease-out hover:-translate-y-2 hover:border-amber-500/30 hover:shadow-[0_20px_50px_-15px_rgba(245,158,11,0.15)] flex flex-col justify-between group">
                <div>
                    <div class="flex items-center justify-between mb-6">
                        <span class="text-xs font-semibold px-3 py-1 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">In Sviluppo</span>
                        <span class="text-xs text-slate-500 font-mono tracking-wider uppercase">Mobile App</span>
                    </div>
                    
                    <h3 class="text-2xl font-bold text-white mb-3 tracking-tight group-hover:text-amber-400 transition-colors duration-300">Puppyon</h3>
                    <p class="text-slate-400 text-sm md:text-base leading-relaxed mb-8">
                        Una piattaforma social innovativa dedicata ai contest fotografici per animali domestici. L'applicazione integra una custom token economy interna per gestire premi e votazioni.
                    </p>
                </div>
                
                <div class="mt-auto">
                    <div class="flex flex-wrap gap-2 text-xs font-mono text-amber-400/85">
                        <span class="px-2 py-1 rounded-md bg-slate-900/60 border border-slate-800/40">#Flutter</span>
                        <span class="px-2 py-1 rounded-md bg-slate-900/60 border border-slate-800/40">#Firebase</span>
                        <span class="px-2 py-1 rounded-md bg-slate-900/60 border border-slate-800/40">#TokenEconomy</span>
                    </div>
                </div>
            </div>

            <!-- Card 2: Pigsty -->
            <div class="relative rounded-3xl p-8 backdrop-blur-md bg-slate-950/40 border border-white/5 shadow-[0_15px_35px_-15px_rgba(0,0,0,0.6)] transition-all duration-500 ease-out hover:-translate-y-2 hover:border-emerald-500/30 hover:shadow-[0_20px_50px_-15px_rgba(16,185,129,0.15)] flex flex-col justify-between group">
                <div>
                    <div class="flex items-center justify-between mb-6">
                        <span class="text-xs font-semibold px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Rilasciato</span>
                        <span class="text-xs text-slate-500 font-mono tracking-wider uppercase">Web App</span>
                    </div>
                    
                    <h3 class="text-2xl font-bold text-white mb-3 tracking-tight group-hover:text-emerald-400 transition-colors duration-300">Pigsty</h3>
                    <p class="text-slate-400 text-sm md:text-base leading-relaxed mb-8">
                        Web app gestionale sviluppata su misura per l'ottimizzazione e il monitoraggio dei processi di un allevamento suinicolo. Ottimizzata per girare fluidamente su dispositivi iOS.
                    </p>
                </div>
                
                <div class="mt-auto">
                    <div class="flex flex-wrap gap-2 text-xs font-mono text-emerald-400/85">
                        <span class="px-2 py-1 rounded-md bg-slate-900/60 border border-slate-800/40">#WebDev</span>
                        <span class="px-2 py-1 rounded-md bg-slate-900/60 border border-slate-800/40">#Firebase</span>
                        <span class="px-2 py-1 rounded-md bg-slate-900/60 border border-slate-800/40">#Responsive</span>
                    </div>
                </div>
            </div>

            <!-- Card 3: Gestioniduemme -->
            <div class="relative rounded-3xl p-8 backdrop-blur-md bg-slate-950/40 border border-white/5 shadow-[0_15px_35px_-15px_rgba(0,0,0,0.6)] transition-all duration-500 ease-out hover:-translate-y-2 hover:border-cyan-500/30 hover:shadow-[0_20px_50px_-15px_rgba(6,182,212,0.15)] flex flex-col justify-between group">
                <div>
                    <div class="flex items-center justify-between mb-6">
                        <span class="text-xs font-semibold px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Attivo</span>
                        <span class="text-xs text-slate-500 font-mono tracking-wider uppercase">Sito Web</span>
                    </div>
                    
                    <h3 class="text-2xl font-bold text-white mb-3 tracking-tight group-hover:text-cyan-400 transition-colors duration-300">Gestioniduemme</h3>
                    <p class="text-slate-400 text-sm md:text-base leading-relaxed mb-8">
                        Progettazione e sviluppo del sito web aziendale. Un'infrastruttura web solida, ottimizzata lato performance e SEO per garantire massima visibilità.
                    </p>
                </div>
                
                <div class="mt-auto space-y-4">
                    <div class="flex flex-wrap gap-2 text-xs font-mono text-cyan-400/85">
                        <span class="px-2 py-1 rounded-md bg-slate-900/60 border border-slate-800/40">#WebDesign</span>
                        <span class="px-2 py-1 rounded-md bg-slate-900/60 border border-slate-800/40">#SEO</span>
                    </div>
                    
                    <div class="pt-2">
                        <a href="https://www.gestioniduemme.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition-colors group/link">
                            Visita il sito <span class="inline-block transition-transform duration-200 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5">&nearr;</span>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

			<!-- 5. CONTATTI -->
<section id="contatti" class="relative w-screen left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] py-32 text-white overflow-hidden m-0 p-0">
    
    <!-- Bagliore liquido sottomarino di sfondo: 
         Questo resta come unica fonte di luce dietro la card -->
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[500px] h-[500px] bg-gradient-to-tr from-cyan-500/10 to-blue-500/5 rounded-full blur-[120px] pointer-events-none z-0"></div>

    <!-- Contenuto principale -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12">
        
        <!-- Card Contatti Fluttuante: 
             Qui manteniamo il blur e lo sfondo per dare l'effetto "vetro sospeso" -->
        <div class="max-w-4xl mx-auto relative rounded-3xl p-8 md:p-16 backdrop-blur-md bg-slate-950/30 border border-white/5 shadow-[0_20px_50px_-20px_rgba(0,0,0,0.7)] transition-all duration-700 ease-out text-center group">
            
            <!-- Icona Fluttuante -->
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-cyan-500/10 to-blue-500/10 flex items-center justify-center text-cyan-400 mx-auto mb-8 border border-cyan-500/20 shadow-inner group-hover:scale-110 transition-transform duration-500">
                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
            </div>

            <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white mb-6">
                Hai un progetto in mente?
            </h2>
            
            <p class="text-slate-400 text-base md:text-lg leading-relaxed max-w-2xl mx-auto mb-10">
                Che si tratti di un'applicazione mobile da lanciare sugli store o di una piattaforma web per ottimizzare il tuo lavoro, contattami per parlarne insieme e trovare la soluzione tecnica ideale.
            </p>
            
            <!-- Pulsante Mail -->
            <div class="inline-block relative group/btn">
                <div class="absolute -inset-0.5 bg-gradient-to-r from-cyan-500 to-blue-500 rounded-2xl blur opacity-30 group-hover/btn:opacity-75 transition duration-500"></div>
                
                <a 
                    href="mailto:info@davidescarpa.com" 
                    class="relative px-8 py-5 bg-slate-950 text-white font-bold rounded-2xl inline-flex items-center gap-3 border border-slate-800/80 transition-colors duration-300 group-hover/btn:bg-slate-900"
                >
                    <span>Invia un'email a: info@davidescarpa.com</span>
                    <svg class="w-5 h-5 text-cyan-400 group-hover/btn:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                </a>
            </div>

        </div>
    </div>
</section>

		</div>
	</div>

</Layout>