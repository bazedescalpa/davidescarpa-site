  }

  .video-frame-container {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .video-glow-wrapper {
    width: 100%;
    max-width: 560px;
    border-radius: 18px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
  }

  .video-frame {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 18px;
    border: none;
    background-color: #000;
  }

  .video-frame video {
    position: absolute;
    top: 0;
    left: 0;
