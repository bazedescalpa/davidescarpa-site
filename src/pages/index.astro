  }

  .location-card:hover {
    transform: translateY(-4px);
  }

  .location-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.2) 100%);
    z-index: 1;
  }

  .location-content {
    position: relative;
    z-index: 2;
    color: #ffffff;
  }

  .location-card h3 {
    font-size: 2.1rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 0.75rem;
    font-family: 'Outfit', sans-serif;
  }

  .location-card p {
    color: #f0f0f0;
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.5;
    font-family: 'Montserrat', sans-serif;
  }

  .location-description {
    padding: 0 0.5rem;
  }

  .location-description p {
    color: #2c2c2c;
    font-size: 0.95rem;
    font-weight: 500;
