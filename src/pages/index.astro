    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .video-shield {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
    background: transparent;
  }

  .text-center {
    text-align: center;
  }

  .text-center h2 {
    font-size: 2.5rem;
    font-weight: 700;
    font-family: 'Outfit', sans-serif;
  }

  .section-subtitle {
    color: #2c2c2c;
    font-weight: 500;
    margin-bottom: 3rem;
    font-family: 'Montserrat', sans-serif;
  }

  .cards-grid {
    background-color: transparent;
    display: grid;
