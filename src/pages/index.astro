      padding: 5rem 0 5rem 0;
      min-height: 600px;
    }
    .grid-2 {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .locations-grid {
      grid-template-columns: 1fr;
    }
    .hero-buttons,
    .action-buttons-container {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }
    .hero-buttons .btn-primary,
    .hero-buttons .btn-secondary,
    .action-buttons-container .btn-primary,
    .btn-equal {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      padding: 0.8rem 1rem;
    }
    .hero h1 {
      font-size: 2.1rem;
      min-height: auto;
      margin-bottom: 1rem;
    }
    .hero-text {
      font-size: 0.95rem;
      margin-bottom: 1.5rem;
    }
  }
</style>