---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileActionBar from '../../components/MobileActionBar.astro';

import filosofiaBg from '../../assets/evento.webp';

// Ausgewählte Bewertungen ins Deutsche übersetzt
const reviews = [
  {
    name: "Paolo A.",
    text: "Exzellentes Massagezentrum im Herzen von Cagliari! Raffinierte, duftende und sehr entspannende Atmosphäre. Ich habe Federicas Professionalität und Freundlichkeit sehr geschätzt. Die Behandlung war tadellos: intensiv und dennoch sanft. Sehr zu empfehlen!",
    rating: 5
  },
  {
    name: "Luigi V.",
    text: "Ich hatte das Vergnügen, eine ayurvedische Massage bei Federica zu erleben, und es war wirklich außergewöhnlich. Vom ersten Moment an spürt man große Professionalität und Leidenschaft für ihre Arbeit. Tief entspannend und wirksam gegen Stress!",
    rating: 5
  },
  {
    name: "Maurizio B.",
    text: "Hervorragende ganzheitliche Erfahrung. Federica war sehr kompetent und professionell. Die Räumlichkeiten sind modern, sauber und gut organisiert. Die Massagewahl ist reichhaltig. 40 Minuten reine Entspannung!",
    rating: 5
  },
  {
    name: "Alessandro S.",
    text: "Ayuwellness zu betreten bedeutet, sich einen Moment echten Wohlbefindens zu gönnen. Das Studio ist wunderschön: warme, harmonische Räume, in denen jedes Detail an die entspannende Atmosphäre ayurvedischer Behandlungen erinnert.",
    rating: 5
  },
  {
    name: "Gloria P.",
    text: "Wunderschöne Erfahrung, Federica ist professionell und sehr sympathisch. Ich habe mich sofort wohlgefühlt. Ich habe die Bein- und Fußmassage geliebt. Ich werde definitiv wiederkommen!",
    rating: 5
  }
];

const duplicatedReviews = [...reviews, ...reviews];
---

<Layout 
  title="Über mich - Federica Ennas | Ayuwellness Cagliari" 
  description="Zertifizierte Ayurveda-Therapeutin mit über zehn Jahren Erfahrung im Forte Village und internationalen Spas. Entdecken Sie den Werdegang von Federica Ennas."
>
  <Header />

  <main>
    <section class="page-header">
      <div class="container">
        <span class="sub-badge">Vorstellung</span>
        <h1>Federica Ennas</h1>
        <p class="subtitle">Zertifizierte Ayurveda-Praktikerin und Expertin für Wohlbefinden.</p>
      </div>
    </section>

    <section class="section">
      <div class="container grid-2">
        <div class="bio-content">
          <h2>Über zehn Jahre Erfahrung im Dienste des Wohlbefindens</h2>
          <p>
            Mein Weg im Bereich des Wohlbefindens basiert auf der tiefen Überzeugung, dass Körper und Geist in einem ständigen, feinen Dialog miteinander stehen. Um sich authentisch um einen Menschen zu kümmern, braucht es ein einfühlsames Zuhören gepaart mit fundiertem Fachwissen.
          </p>
          <p>
            Im Laufe der Jahre habe ich meine berufliche Erfahrung in erstklassigen Häusern gesammelt, darunter im renommierten <strong>Forte Village Resort</strong>, auf Luxuskreuzfahrtschiffen und in internationalen High-End-Spas.
          </p>
          
          <div class="qualifiche-box">
            <h3>Ausbildung und Qualifikationen</h3>
            <ul>
              <li>Ausbildung zur Kosmetikerin am <strong>IAL Sardegna</strong>.</li>
              <li>Diplom als Ayurveda-Therapeutin an der <strong>EFOA</strong>.</li>
              <li>Spezialisierung auf ayurvedische Massagen, ganzheitliche Behandlungen und Wasseranwendungen.</li>
            </ul>
          </div>
        </div>
        
        <div class="mission-card" style={`background-image: url(${filosofiaBg.src});`}>
          <div class="mission-overlay"></div>
          <div class="mission-content">
            <h3>Meine Philosophie</h3>
            <p class="quote">
              "Jede Sitzung ist nicht nur eine einfache Massage, sondern ein einzigartiges Ritual, bei dem achtsames Zuhören und jahrtausendealte Traditionen verschmelzen, um tiefen Frieden zu schenken."
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="reviews-section">
      <div class="container">
        <div class="reviews-header">
          <span class="sub-badge">Kundenstimmen</span>
          <h2>Worte Unserer Gäste</h2>
          <p class="subtitle">Das Vertrauen derer, die unsere Wellness-Rituale gewählt haben.</p>
        </div>
      </div>

      <div class="carousel-container">
        <div class="carousel-track">
          {duplicatedReviews.map((review) => (
            <div class="review-card">
              <div class="stars">
                {Array.from({ length: review.rating }).map(() => (
                  <span class="star">★</span>
                ))}
              </div>
              <p class="review-text">"{review.text}"</p>
              <div class="review-author">
                <strong>{review.name}</strong>
                <span class="google-badge">Google Bewertung</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <MobileActionBar lang="de" />
</Layout>

<style>
  /* SFONDO BIANCO PURO PER LA PAGINA */
  main {
    background-color: #ffffff !important;
  }

  .page-header {
    padding: 5rem 0 3rem 0;
    text-align: center;
    background-color: transparent;
  }

  .sub-badge {
    display: inline-block;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 2px;
    color: var(--accent);
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .page-header h1 {
    font-size: clamp(2.5rem, 4vw, 3rem);
    margin-bottom: 0.5rem;
    color: #c4a724 !important;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .section {
    padding: 4rem 0 2rem 0;
    background-color: transparent;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: stretch;
  }

  .bio-content h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    color: #c4a724 !important;
  }

  .bio-content p {
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }

  .qualifiche-box {
    margin-top: 2.5rem;
    background-color: var(--accent-light);
    padding: 2.5rem;
    border-radius: 20px;
    border: none !important;
    box-shadow: none !important;
  }

  .qualifiche-box h3 {
    font-size: 1.2rem;
    margin-bottom: 1rem;
    color: var(--text-main);
  }

  .qualifiche-box ul {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--text-muted);
  }

  .qualifiche-box li {
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }

  .mission-card {
    position: relative;
    background-size: cover;
    background-position: center;
    color: #fff;
    padding: 3rem;
    border-radius: 20px;
    box-shadow: 0 20px 40px rgba(44, 42, 41, 0.06);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    min-height: 100%;
    border: none !important;
  }

  .mission-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(44, 42, 41, 0.55);
    z-index: 1;
  }

  .mission-content {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .mission-card h3 {
    color: #c4a724;
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .quote {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.6;
    margin-bottom: 0;
    color: #fcfbfa;
  }

  .reviews-section {
    padding: 3rem 0 6rem 0;
    background-color: transparent;
    overflow: hidden;
  }

  .reviews-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .reviews-header h2 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    color: #c4a724 !important;
  }

  .carousel-container {
    width: 100%;
    position: relative;
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
  }

  .carousel-track {
    display: flex;
    gap: 2.5rem;
    width: max-content;
    animation: scrollCarousel 35s linear infinite;
  }

  .carousel-container:hover .carousel-track {
    animation-play-state: paused;
  }

  @keyframes scrollCarousel {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - 1.25rem));
    }
  }

  .review-card {
    background-color: #faf8f5;
    padding: 2.5rem;
    border-radius: 20px;
    box-shadow: 0 20px 40px rgba(44, 42, 41, 0.04);
    width: 380px;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: none !important;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .review-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 25px 50px rgba(196, 167, 36, 0.12);
  }

  .stars {
    color: #c4a724;
    font-size: 1.2rem;
    letter-spacing: 2px;
    margin-bottom: 1rem;
  }

  .review-text {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .review-author {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(196, 167, 36, 0.15);
    padding-top: 1rem;
  }

  .review-author strong {
    color: var(--text-main);
    font-size: 0.95rem;
  }

  .google-badge {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 0.2rem;
  }

  @media (max-width: 900px) {
    .grid-2 {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .mission-card {
      min-height: 350px;
    }
    .review-card {
      width: 300px;
      padding: 2rem;
    }
    .carousel-track {
      animation-duration: 25s;
    }
  }
</style>