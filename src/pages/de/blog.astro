---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileActionBar from '../../components/MobileActionBar.astro';

const posts = [
  {
    title: "Die Vorteile der Shirodhara-Massage gegen Stress und Schlaflosigkeit",
    date: "15. Mai 2026",
    excerpt: "Erfahren Sie, wie der stetige warme Ölstrahl auf der Stirn auf das Nervensystem wirkt und für tiefe innere Ruhe sorgt.",
    category: "Ayurveda"
  },
  {
    title: "Wohlbefinden auf Sardinien: Warum ayurvedische Behandlungen in Cagliari wählen?",
    date: "28. April 2026",
    excerpt: "Eine Reise zu den traditionellen Ritualen zur Harmonisierung der Doshas Vata, Pitta und Kapha beim Jahreszeitenwechsel.",
    category: "Wohlbefinden"
  },
  {
    title: "Massage-Hausbesuche in Villasimius: Totale Entspannung unter der Sonne",
    date: "10. Juni 2026",
    excerpt: "Genießen Sie den Sommer an der Südostküste Sardiniens und verbinden Sie Meeresidylle mit den Vorteilen einer individuellen Behandlung.",
    category: "Villasimius"
  }
];
---

<Layout 
  title="Wellness Blog & Einblicke | Ayuwellness" 
  description="Artikel, Tipps und Wissen über Ayurveda, entspannende Massagen und Wellness-Rituale in Cagliari und Villasimius von Federica Ennas."
>
  <Header />

  <main>
    <section class="page-header">
      <div class="container">
        <span class="sub-badge">Tipps & Wissen</span>
        <h1>Der Wellness-Blog</h1>
        <p class="subtitle">Artikel und Gedanken über die Kunst des Ayurveda und die Achtsamkeit für sich selbst.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="blog-grid">
          {posts.map((post) => (
            <article class="blog-card">
              <div class="blog-meta">
                <span class="blog-category">{post.category}</span>
                <span class="blog-date">{post.date}</span>
              </div>
              <h2>{post.title}</h2>
              <p>{post.excerpt}</p>
              <div class="blog-footer">
                <span class="read-more">Artikel lesen &rarr;</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <MobileActionBar lang="de" />
</Layout>

<style>
  main {
    background-color: #ffffff !important;
  }

  .page-header {
    padding: 5rem 0 3rem 0;
    text-align: center;
    background-color: transparent;
  }

  .sub-badge {
    display: inline-block;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 2px;
    color: var(--accent);
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .page-header h1 {
    font-size: clamp(2.5rem, 4vw, 3rem);
    margin-bottom: 0.5rem;
    color: #c4a724 !important;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .section {
    padding: 4rem 0 6rem 0;
    background-color: transparent;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2.5rem;
  }

  .blog-card {
    background-color: #faf8f5;
    padding: 2.5rem;
    border-radius: 20px;
    box-shadow: 0 20px 40px rgba(44, 42, 41, 0.04);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: none !important;
  }

  .blog-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    font-size: 0.8rem;
  }

  .blog-category {
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--accent);
    font-weight: 600;
  }

  .blog-date {
    color: var(--text-muted);
  }

  .blog-card h2 {
    font-size: 1.35rem;
    margin-bottom: 1rem;
    color: var(--text-main);
    line-height: 1.4;
  }

  .blog-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .blog-footer {
    border-top: 1px solid rgba(196, 167, 36, 0.15);
    padding-top: 1.25rem;
    margin-top: auto;
  }

  .read-more {
    color: var(--text-main);
    font-weight: 600;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .blog-card:hover .read-more {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>