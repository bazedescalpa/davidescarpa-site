---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro'; 
import Footer from '../../components/Footer.astro';
import MobileActionBar from '../../components/MobileActionBar.astro';

import carosello1 from '../../assets/carosello1.webp';
import carosello2 from '../../assets/carosello2.webp';
import carosello3 from '../../assets/carosello3.webp';
import carosello4 from '../../assets/carosello4.webp';

import cagliariBg from '../../assets/cagliari.webp';
import villasimiusBg from '../../assets/villasimius.webp';
import shirodharaBg from '../../assets/shirodhara.webp';
import pindaswedaBg from '../../assets/pindasweda.webp';
import massaggiPersonalizzatiBg from '../../assets/massaggi_personalizzati.webp';
import quieteBg from '../../assets/quiete.webp';

const heroSlides = [
  {
    image: carosello1.src,
    title: "Ayurvedic Massages in Cagliari",
  },
  {
    image: carosello2.src,
    title: "Customized Ayurvedic Treatments",
  },
  {
    image: carosello3.src,
    title: "Your Wellness Ritual in Sardinia",
  },
  {
    image: carosello4.src,
    title: "In-home Massages in Villasimius",
  },
];
---

<Layout title="Ayuwellness | Luxury for the Mind in Cagliari & Villasimius">
  <Header />

  <main>
    <!-- Sezione Hero con Carosello -->
    <section class="hero">
      {heroSlides.map((slide, index) => (
        <div 
          class={`hero-slide ${index === 0 ? 'active' : ''}`} 
          style={`background-image: url(${slide.image});`}
        >
          <div class="container hero-content">
            <h1>{slide.title}</h1>
            <p class="hero-text">
              Customized Ayurvedic massages and holistic treatments to restore balance between body and mind. In Cagliari during winter and Villasimius in summer.
            </p>
            <div class="hero-buttons">
              <a href="/en/massages" class="btn-primary btn-equal">Discover massages</a>
              <a href="/en/treatments" class="btn-primary btn-equal">Discover treatments</a>
              <a href="https://wa.me/393270567128" target="_blank" rel="noopener noreferrer" class="btn-secondary">Book now</a>
            </div>
          </div>
        </div>
      ))}
    </section>

    <!-- Sezione Presentazione / Studio con Sfondo Bianco, Testi scuri e link giallo -->
    <section class="section about-preview">
      <div class="container grid-2">
        <div class="about-text">
          <h2 class="section-title-gold">An experience of authentic wellness</h2>
          <p>
            The <strong>Ayuwellness</strong> studio offers a haven of peace in Cagliari, dedicated to those who want to release tension, eliminate toxins, and rejuvenate through the principles of ancient Ayurvedic tradition.
          </p>
          <p>
            Each path is tailored based on individual constitution (Vata, Pitta, Kapha doshas), combining medicated oils and skilled manual techniques.
          </p>
          <a href="/en/about" class="text-link">Meet Federica Ennas &rarr;</a>
        </div>
        
        <!-- Cornice con Video HTML5 Nativo senza bagliore -->
        <div class="video-frame-container">
          <div class="video-glow-wrapper">
            <div class="video-frame">
              <video 
                id="native-video"
                autoplay 
                muted 
                playsinline 
                preload="auto">
                <source src="/video/ayurveda.mp4" type="video/mp4" />
                Your browser does not support the video tag.
              </video>
              <!-- Scudo protettivo totale che impedisce interazioni o click -->
              <div class="video-shield"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Testo stagionale con a capo iniziale e margine superiore -->
      <div class="container season-text-container">
        <p class="season-description">
          <br>During the winter season, treatments take place mainly in the heart of Cagliari, while in the summer period the service also moves to Villasimius, offering an Ayurvedic wellness experience in total harmony with seasonal rhythms and visitors' needs.
        </p>
      </div>

      <!-- Sotto: Due colonne con le card in alto e le descrizioni complete sotto -->
      <div class="container locations-grid-container">
        <div class="locations-grid">
          
          <!-- Colonna Cagliari -->
          <div class="location-column">
            <div class="location-card" style={`background-image: url(${cagliariBg.src});`}>
              <div class="location-overlay"></div>
              <div class="location-content">
                <h3>Cagliari</h3>
                <p>The winter winter sanctuary of peace, where you can rediscover inner balance between city rhythms and personal care.</p>
              </div>
            </div>
            <div class="location-description">
              <p>Health and wellness are increasingly at the center of attention, and to meet this need, Ayuwellness luxury for the mind has opened its studio in Cagliari.</p>
              <p>Ayurveda is an ancient system of Indian medicine based on the balance between mind, body, and spirit, and Ayurvedic massages represent the most natural way to achieve this harmony.</p>
              <p>The studio at Via Basilicata 61, in the La Vega district, offers a wide range of customized treatments for every need. Traditional techniques and natural products are used to reduce stress, improve blood circulation, and relieve joint pain.</p>
              <p>The cozy and relaxing environment invites you to immerse yourself in a unique experience of Ayurvedic well-being. All treatments are performed with organic oils and natural products to ensure maximum quality. The studio collaborates with B&Bs, hotels, yachts, and tourist facilities, and is easily accessible for visitors exploring the Sardinian capital.</p>
            </div>
          </div>

          <!-- Colonna Villasimius -->
          <div class="location-column">
            <div class="location-card" style={`background-image: url(${villasimiusBg.src});`}>
              <div class="location-overlay"></div>
              <div class="location-content">
                <h3>Villasimius</h3>
                <p>Summer wellness between beaches and relaxation, to regenerate body and mind during your holidays in southern Sardinia.</p>
              </div>
            </div>
            <div class="location-description">
              <p>The pleasure of receiving an Ayurvedic massage in the comfort of your own villa or directly on a yacht. Ayuwellness brings in-home wellness to the areas of Villasimius, Solanas, Torre delle Stelle, Costa Rei, Muravera, and Castiadas.</p>
              <p>Outside under the moonlight or in an airy veranda during the day, every moment becomes perfect to treat yourself to a rejuvenating session.</p>
              <p>The service is available by reservation and requires a quiet, comfortable, and peaceful environment.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Sezione Trattamenti in Evidenza -->
    <section class="section bg-light">
      <div class="container text-center">
        <h2 class="section-title-gold">Ayurvedic Rituals</h2>
        <p class="section-subtitle">From Shirodhara to Pindasweda: targeted treatments for every need.</p>
        
        <div class="cards-grid">
          <a href="/en/massages" class="service-card service-card-image" style={`background-image: url(${shirodharaBg.src}); text-decoration: none;`}>
            <div class="service-card-overlay"></div>
            <div class="service-card-content">
              <h3>Shirodhara</h3>
              <p>The steady stream of warm oil on the forehead to deeply calm the mind and nervous system.</p>
            </div>
          </a>
          <a href="/en/massages" class="service-card service-card-image" style={`background-image: url(${pindaswedaBg.src}); text-decoration: none;`}>
            <div class="service-card-overlay"></div>
            <div class="service-card-content">
              <h3>Pindasweda</h3>
              <p>Massage with warm herbal boluses, ideal for dissolving muscle tightness and purifying.</p>
            </div>
          </a>
          <a href="/en/massages" class="service-card service-card-image" style={`background-image: url(${massaggiPersonalizzatiBg.src}); text-decoration: none;`}>
            <div class="service-card-overlay"></div>
            <div class="service-card-content">
              <h3>Customized Massages</h3>
              <p>Tailored rituals based on listening to the person and harmonizing the doshas.</p>
            </div>
          </a>
        </div>

        <div class="action-buttons-container">
          <a href="/en/massages" class="btn-primary btn-equal">Explore Complete Massages Menu</a>
          <a href="/en/treatments" class="btn-primary btn-equal">Explore Complete Treatments Menu</a>
        </div>
      </div>
    </section>

    <!-- Sezione Eventi / L'angolo della coccola -->
    <section class="section">
      <div class="container grid-2 align-center">
        <div>
          <span class="sub-badge">For your special events</span>
          <h2 class="section-title-gold" style="text-align: left;">The Pampering Corner</h2>
          <p>
            Make weddings, birthdays, or private parties unforgettable. Offer your guests an exclusive 10-minute relaxation moment dedicated to hands or feet with natural oils and warm towels.
          </p>
          <a href="https://wa.me/393270567128?text=Hello,%20I%20would%20like%20information%20or%20to%20book%20an%20event%20with%20The%20Pampering%20Corner." target="_blank" rel="noopener noreferrer" class="btn-primary" style="margin-top: 1.5rem; display: inline-block;">Book an Event</a>
        </div>
        <div class="highlight-box" style={`background-image: url(${quieteBg.src});`}>
          <div class="highlight-overlay"></div>
          <p class="quote">"True luxury is not material: it is taking care of yourself and gifting yourself a space of pure quiet."</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <MobileActionBar />
</Layout>

<script>
  // Carosello Hero
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.hero-slide');
    if (slides.length > 0) {
      let currentIndex = 0;
      const intervalTime = 5000;

      function nextSlide() {
        slides[currentIndex].classList.remove('active');
        currentIndex = (currentIndex + 1) % slides.length;
        slides[currentIndex].classList.add('active');
      }

      setInterval(nextSlide, intervalTime);
    }

    // Gestione Loop nativo HTML5 dal secondo 3 al secondo 9
    const video = document.getElementById('native-video') as HTMLVideoElement;
    if (video) {
      video.currentTime = 3;

      video.addEventListener('timeupdate', () => {
        if (video.currentTime >= 9.0) {
          video.currentTime = 3;
          video.play();
        }
      });
    }
  });
</script>

<style>
  .quote {
    font-family: 'Outfit', sans-serif;
    font-style: normal;
  }

  .hero {
    position: relative;
    width: 100%;
    min-height: 550px;
