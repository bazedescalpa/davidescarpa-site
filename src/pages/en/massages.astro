---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileActionBar from '../../components/MobileActionBar.astro';
import { Image } from 'astro:assets';

import massaggio1 from '../../assets/massaggio4.jpeg';
import massaggio2 from '../../assets/massaggio_in_gravidanza.webp';
import massaggio3 from '../../assets/trattamenti.webp';
import massaggio4 from '../../assets/piedi1.jpeg';
import massaggio5 from '../../assets/massaggio_in_acqua.webp';

const treatments = [
  {
    name: "Customized Ayurvedic Massage",
    desc: "A tailored ritual created after listening to and evaluating individual constitutions according to the principles of the doshas (Vata, Pitta, Kapha), using warm medicated oils.",
    tag: "Tailored",
    image: massaggio1
  },
  {
    name: "Pregnancy Massage",
    desc: "A gentle, safe treatment designed specifically for expectant mothers to relieve back tension, reduce swelling, and offer deep relaxation.",
    tag: "Maternity",
    image: massaggio2
  },
  {
    name: "Sports Massage",
    desc: "A targeted treatment to dissolve deep muscle contractions, improve circulation, and promote physical recovery after exercise or physical exertion.",
    tag: "Performance",
    image: massaggio3
  },
  {
    name: "Foot Massage",
    desc: "A treatment focused on reflexology and plantar wellness, ideal for stimulating energy points, reviving circulation, and providing a feeling of lightness.",
    tag: "Relaxing",
    image: massaggio4
  },
  {
    name: "Water Massage",
    desc: "An immersive and regenerating experience that uses weightlessness and the comfort of warm water to dissolve tension and reach deep sensory surrender.",
    tag: "Exclusive",
    image: massaggio5
  }
];
---

<Layout 
  title="Ayurvedic Massages | Ayuwellness Cagliari & Villasimius" 
  description="Discover our menu of Ayurvedic and holistic treatments: customized, sports, water, and reflexology massages in Cagliari and Villasimius."
>
  <Header />

  <main>
    <section class="page-header">
      <div class="container">
        <span class="sub-badge">Ayurvedic Rituals</span>
        <h1>Massages for Body & Mind</h1>
        <p class="subtitle">Every path is personalized to meet the unique needs of your body and mind.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="treatments-vertical-list">
          {treatments.map((t, index) => (
            <div class={`treatment-card-large ${index % 2 !== 0 ? 'reversed' : ''}`}>
              <div class="treatment-image-wrapper">
                <Image 
                  src={t.image} 
                  alt={t.name} 
                  width={800} 
                  format="webp" 
                  quality={90}
                  class="treatment-img"
                />
              </div>
              <div class="treatment-content">
                <span class="treatment-tag">{t.tag}</span>
                <h2>{t.name}</h2>
                <p>{t.desc}</p>
                <div class="card-footer">
                  <a 
                    href={`https://wa.me/393270567128?text=Hello,%20I%20would%20like%20to%20book%20the%20treatment:%20${encodeURIComponent(t.name)}`} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="book-link"
                  >
                    Book treatment &rarr;
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="cta-banner">
          <h3>Want to find out which treatment suits you best?</h3>
          <p>Contact us for a personalized consultation or to book your session in Cagliari or Villasimius.</p>
          <a 
            href="https://wa.me/393270567128?text=Hello,%20I%20would%20like%20a%20personalized%20consultation%20for%20treatments." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-primary"
          >
            Contact Federica
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <MobileActionBar lang="en" />
</Layout>

<style>
  main {
    background-color: #ffffff !important;
  }

  .page-header {
    padding: 5rem 0 2rem 0;
    text-align: center;
    background-color: transparent;
  }

  .sub-badge {
    display: inline-block;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 2px;
    color: var(--accent);
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .page-header h1 {
    font-size: clamp(2.5rem, 4vw, 3rem);
    margin-bottom: 0.5rem;
    color: #c4a724 !important; 
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .section {
    padding: 3rem 0 6rem 0;
    background-color: transparent;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .treatments-vertical-list {
    display: flex;
    flex-direction: column;
    gap: 6rem;
    margin-bottom: 5rem;
  }

  .treatment-card-large {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    background: transparent !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
  }

  .treatment-card-large.reversed .treatment-image-wrapper {
    order: 2;
    border-radius: 0 20px 20px 0 !important;
  }

  .treatment-card-large.reversed .treatment-content {
    order: 1;
  }

  .treatment-image-wrapper {
    width: 100%;
    height: 400px;
    overflow: hidden;
    border-radius: 20px 0 0 20px; 
    box-shadow: 0 20px 40px rgba(44, 42, 41, 0.06);
    background: transparent;
    border: none !important;
  }

  .treatment-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s ease;
  }

  .treatment-card-large:hover .treatment-img {
    transform: scale(1.03);
  }

  .treatment-content {
    padding: 1rem 0;
    background: transparent;
    border: none !important;
  }

  .treatment-tag {
    display: inline-block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .treatment-content h2 {
    font-size: 2.2rem;
    margin-bottom: 1rem;
    color: #c4a724 !important;
  }

  .treatment-content p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .card-footer {
    border: none !important;
    padding-top: 0;
    background: transparent;
  }

  .book-link {
    color: var(--text-main);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    transition: color 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .book-link:hover {
    color: var(--accent);
  }

  .cta-banner {
    background-color: var(--accent-light);
    padding: 4rem 2rem;
    border-radius: 20px;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    border: none !important;
    box-shadow: none !important;
  }

  .cta-banner h3 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
    color: var(--text-main);
  }

  .cta-banner p {
    color: var(--text-muted);
    margin-bottom: 2rem;
    font-size: 1.1rem;
  }

  .btn-primary {
    display: inline-block;
    background-color: var(--accent);
    color: #fff;
    padding: 0.9rem 2.5rem;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 15px rgba(163, 139, 116, 0.2);
    transition: transform 0.2s ease;
    border: none;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .treatment-card-large, 
    .treatment-card-large.reversed {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .treatment-card-large .treatment-image-wrapper,
    .treatment-card-large.reversed .treatment-image-wrapper {
      order: 1 !important;
      height: 260px;
      border-radius: 20px 20px 0 0 !important; 
    }
    
    .treatment-card-large .treatment-content {
      order: 2 !important;
      padding: 0 0.5rem 2rem 0.5rem !important;
    }

    .treatment-content h2 {
      font-size: 1.75rem;
    }
  }
</style>