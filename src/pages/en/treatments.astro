---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileActionBar from '../../components/MobileActionBar.astro';
import { Image } from 'astro:assets';

// Import treatment images with correct relative path from src/pages/en/
import trattamento1 from '../../assets/shirodhara.webp';
import trattamento2 from '../../assets/pindasweda.webp'; 
import trattamento3 from '../../assets/evento.webp';
import trattamento4 from '../../assets/massaggi_personalizzati.webp';
import trattamento5 from '../../assets/carosello2.webp';
import trattamento6 from '../../assets/fanghi.webp';

const treatments = [
  {
    name: "Shirodhara",
    desc: "The ultimate Ayurvedic royal treatment. A continuous, gentle stream of warm medicated oil poured steadily onto the forehead (third eye), ideal for calming the mind, relieving deep anxiety, insomnia, and profound stress.",
    tag: "Supreme Ritual",
    image: trattamento1
  },
  {
    name: "Pindasweda",
    desc: "A deep massage performed by rhythmically tapping the body with warm cotton bolsters filled with medicinal herbs, spices, and medicated rice. Excellent for nourishing tissues, releasing joint stiffness, and reactivating metabolism.",
    tag: "Revitalizing",
    image: trattamento2
  },
  {
    name: "Vasti",
    desc: "Precise localized treatments (such as Kati Vasti for the lower back or Janu Vasti for the knees) where a dough dam holds warm medicated oil directly over the target area for focused relief.",
    tag: "Targeted",
    image: trattamento3
  },
  {
    name: "Swedana",
    desc: "Ayurvedic herbal steam bath. While the body receives warm steam enriched with balsamic essences, the head stays cool. Promotes deep detoxification and relaxes muscles.",
    tag: "Detox",
    image: trattamento4
  },
  {
    name: "Ayurvedic Treatments & Paths",
    desc: "Comprehensive holistic journeys based on the ancient science of life, designed to rebalance the Doshas and restore lasting harmony between physical, mental, and energetic well-being.",
    tag: "Holistic Philosophy",
    image: trattamento5
  },
  {
    name: "Dead Sea Mud Wrap",
    desc: "Purifying and remineralizing treatment that harnesses the unique properties of natural mud to cleanse the skin, stimulate microcirculation, drain excess fluids, and provide immediate toning.",
    tag: "Purifying",
    image: trattamento6
  }
];
---

<Layout 
  title="Ayurvedic Treatments & Rituals | Ayuwellness Cagliari" 
  description="Discover advanced Ayurvedic treatments: Shirodhara, Pindasweda, Vasti, Swedana, Ayurveda paths, and Dead Sea mud wraps in Cagliari and Villasimius."
>
  <Header />

  <main>
    <section class="page-header">
      <div class="container">
        <span class="sub-badge">Ayurvedic Excellence</span>
        <h1>Special Treatments & Rituals</h1>
        <p class="subtitle">Ancient traditional techniques to guide you on a journey of profound regeneration.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="treatments-vertical-list">
          {treatments.map((t, index) => (
            <div class={`treatment-card-large ${index % 2 !== 0 ? 'reversed' : ''}`}>
              <div class="treatment-image-wrapper">
                <Image 
                  src={t.image} 
                  alt={t.name} 
                  width={800} 
                  format="webp" 
                  quality={90}
                  class="treatment-img"
                />
              </div>
              <div class="treatment-content">
                <span class="treatment-tag">{t.tag}</span>
                <h2>{t.name}</h2>
                <p>{t.desc}</p>
                <div class="card-footer">
                  <a 
                    href={`https://wa.me/393270567128?text=Hello,%20I%20would%20like%20to%20book%20the%20treatment:%20${encodeURIComponent(t.name)}`} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="book-link"
                  >
                    Book treatment &rarr;
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="cta-banner">
          <h3>Need guidance in choosing the ideal ritual?</h3>
          <p>Contact us for a personalized consultation or to find out which Ayurvedic journey resonates most with your needs.</p>
          <a 
            href="https://wa.me/393270567128?text=Hello,%20I%20would%20like%20a%20personalized%20consultation%20for%20Ayurvedic%20treatments." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-primary"
          >
            Contact Federica
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <MobileActionBar lang="en" />
</Layout>

<style>
  main {
    background-color: #ffffff !important;
  }

  .page-header {
    padding: 5rem 0 2rem 0;
    text-align: center;
    background-color: transparent;
  }

  .sub-badge {
    display: inline-block;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 2px;
    color: var(--accent);
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .page-header h1 {
    font-size: clamp(2.5rem, 4vw, 3rem);
    margin-bottom: 0.5rem;
    color: #c4a724 !important; 
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .section {
    padding: 3rem 0 6rem 0;
    background-color: transparent;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .treatments-vertical-list {
    display: flex;
    flex-direction: column;
    gap: 6rem;
    margin-bottom: 5rem;
  }

  .treatment-card-large {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    background: transparent !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
  }

  .treatment-card-large.reversed .treatment-image-wrapper {
    order: 2;
    border-radius: 0 20px 20px 0 !important;
  }

  .treatment-card-large.reversed .treatment-content {
    order: 1;
  }

  .treatment-image-wrapper {
    width: 100%;
    height: 400px;
    overflow: hidden;
    border-radius: 20px 0 0 20px; 
    box-shadow: 0 20px 40px rgba(44, 42, 41, 0.06);
    background: transparent;
    border: none !important;
  }

  .treatment-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s ease;
  }

  .treatment-card-large:hover .treatment-img {
    transform: scale(1.03);
  }

  .treatment-content {
    padding: 1rem 0;
    background: transparent;
    border: none !important;
  }

  .treatment-tag {
    display: inline-block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .treatment-content h2 {
    font-size: 2.2rem;
    margin-bottom: 1rem;
    color: #c4a724 !important;
  }

  .treatment-content p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .card-footer {
    border: none !important;
    padding-top: 0;
    background: transparent;
  }

  .book-link {
    color: var(--text-main);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    transition: color 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .book-link:hover {
    color: var(--accent);
  }

  .cta-banner {
    background-color: var(--accent-light);
    padding: 4rem 2rem;
    border-radius: 20px;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    border: none !important;
    box-shadow: none !important;
  }

  .cta-banner h3 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
    color: var(--text-main);
  }

  .cta-banner p {
    color: var(--text-muted);
    margin-bottom: 2rem;
    font-size: 1.1rem;
  }

  .btn-primary {
    display: inline-block;
    background-color: var(--accent);
    color: #fff;
    padding: 0.9rem 2.5rem;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 15px rgba(163, 139, 116, 0.2);
    transition: transform 0.2s ease;
    border: none;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .treatment-card-large, 
    .treatment-card-large.reversed {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .treatment-card-large .treatment-image-wrapper,
    .treatment-card-large.reversed .treatment-image-wrapper {
      order: 1 !important;
      height: 260px;
      border-radius: 20px 20px 0 0 !important; 
    }
    
    .treatment-card-large .treatment-content {
      order: 2 !important;
      padding: 0 0.5rem 2rem 0.5rem !important;
    }

    .treatment-content h2 {
      font-size: 1.75rem;
    }
  }
</style>