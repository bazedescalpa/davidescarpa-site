---
// src/pages/blog/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Recupera tutti i post non bozza e ordinali per data
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog | Davide Scarpa Soluzioni Web">
  <!-- 
    Sezione pulita: senza bg-slate-950 o hack di larghezza,
    eredita lo sfondo globale in parallasse dal Layout.
  -->
  <section class="relative pt-32 pb-32 text-white min-h-screen">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      
      <!-- Intestazione -->
      <div class="mb-20 max-w-2xl">
        <span class="text-cyan-400 text-sm font-semibold tracking-wider uppercase block mb-2">Risorse & Idee</span>
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white mb-4">Il mio Blog</h1>
        <p class="text-slate-400 text-lg leading-relaxed">
          Condivido riflessioni, guide tecniche e strategie su sviluppo web, app mobile e ottimizzazione digitale.
        </p>
      </div>

      <!-- Griglia Articoli -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <article class="relative rounded-3xl p-8 backdrop-blur-md bg-slate-950/40 border border-slate-900/50 shadow-[0_15px_35px_-15px_rgba(0,0,0,0.6)] transition-all duration-500 ease-out hover:-translate-y-2 hover:border-cyan-500/30 hover:shadow-[0_20px_50px_-15px_rgba(6,182,212,0.2)] flex flex-col justify-between group">
            <div>
              {post.data.image && (
                <div class="overflow-hidden rounded-2xl mb-6 border border-slate-900/40">
                  <img 
                    src={post.data.image} 
                    alt={post.data.title} 
                    class="w-full h-48 object-cover transition-transform duration-500 group-hover:scale-105" 
                    loading="lazy"
                  />
                </div>
              )}
              <span class="text-xs text-cyan-400 font-mono tracking-wider block mb-3">
                {post.data.pubDate.toLocaleDateString('it-IT', { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
              <h2 class="text-2xl font-bold text-white mb-3 tracking-tight group-hover:text-cyan-400 transition-colors duration-300">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h2>
              <p class="text-slate-400 text-sm md:text-base leading-relaxed mb-6 line-clamp-3">{post.data.description}</p>
            </div>
            
            <a href={`/blog/${post.id}`} class="text-cyan-400 text-sm font-semibold inline-flex items-center gap-1.5 hover:text-cyan-300 transition-colors">
              Leggi articolo <span class="inline-block transition-transform duration-200 group-hover:translate-x-0.5">&rarr;</span>
            </a>
          </article>
        ))}
      </div>

    </div>
  </section>
</Layout>