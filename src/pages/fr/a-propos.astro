---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileActionBar from '../../components/MobileActionBar.astro';

import filosofiaBg from '../../assets/evento.webp';

// Avis sélectionnés traduits en français
const reviews = [
  {
    name: "Paolo A.",
    text: "Un excellent centre de massage au cœur de Cagliari ! Une atmosphère raffinée, parfumée et très relaxante. J'ai beaucoup apprécié le professionnalisme et la gentillesse de Federica. Le soin était impeccable : intense mais délicat. Très hautement recommandé !",
    rating: 5
  },
  {
    name: "Luigi V.",
    text: "J'ai eu le plaisir d'essayer un massage ayurvédique avec Federica et l'expérience a été vraiment exceptionnelle. Dès le premier instant, on ressent un grand professionnalisme et de la passion. Le soin était profondément relaxant et libérateur de tensions.",
    rating: 5
  },
  {
    name: "Maurizio B.",
    text: "Excellente expérience holistique. Federica a été très douée et professionnelle. L'établissement est moderne, propre et bien organisé. J'ai essayé un massage ayurvédique et c'était 40 minutes de pure relaxation. À recommander !",
    rating: 5
  },
  {
    name: "Alessandro S.",
    text: "Entrer chez Ayuwellness, c'est s'offrir un moment de vrai bien-être. Le studio est magnifique : des espaces chaleureux et harmonieux où chaque détail rappelle l'atmosphère relaxante des soins ayurvédiques.",
    rating: 5
  },
  {
    name: "Gloria P.",
    text: "Superbe expérience, Federica est professionnelle et très sympathique. Je me suis tout de suite sentie à l'aise. J'ai adoré le massage des jambes et des pieds. Je reviendrai à coup sûr !",
    rating: 5
  }
];

const duplicatedReviews = [...reviews, ...reviews];
---

<Layout 
  title="À Propos - Federica Ennas | Ayuwellness Cagliari" 
  description="Praticienne ayurvédique certifiée avec plus de dix ans d'expérience au Forte Village et dans des spas internationaux. Découvrez le parcours de Federica Ennas."
>
  <Header />

  <main>
    <section class="page-header">
      <div class="container">
        <span class="sub-badge">Présentation</span>
        <h1>Federica Ennas</h1>
        <p class="subtitle">Praticienne en Ayurvéda certifiée et professionnelle du bien-être.</p>
      </div>
    </section>

    <section class="section">
      <div class="container grid-2">
        <div class="bio-content">
          <h2>Plus de dix ans d'expérience au service du bien-être</h2>
          <p>
            Mon parcours dans le monde du bien-être est né de la profonde conviction que le corps et l'esprit sont en dialogue constant. Prendre soin d'une personne de manière authentique nécessite d'allier l'écoute attentive à une solide préparation technique.
          </p>
          <p>
            Au fil des ans, j'ai développé mon expérience professionnelle dans des établissements de prestige, notamment le renommé <strong>Forte Village Resort</strong>, des navires de croisière et des spas internationaux de haut niveau.
          </p>
          
          <div class="qualifiche-box">
            <h3>Formation et Qualifications</h3>
            <ul>
              <li>Qualification d'Esthéticienne obtenue à l'<strong>IAL Sardegna</strong>.</li>
              <li>Diplôme de Praticienne en Ayurvéda délivré par l'<strong>EFOA</strong>.</li>
              <li>Spécialisation en massages ayurvédiques, soins holistiques et massages aquatiques.</li>
            </ul>
          </div>
        </div>
        
        <div class="mission-card" style={`background-image: url(${filosofiaBg.src});`}>
          <div class="mission-overlay"></div>
          <div class="mission-content">
            <h3>Ma Philosophie</h3>
            <p class="quote">
              "Chaque séance n'est pas un simple massage, mais un rituel unique où l'écoute attentive et les traditions millénaires se mélangent pour restaurer l'harmonie e la quiétude."
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="reviews-section">
      <div class="container">
        <div class="reviews-header">
          <span class="sub-badge">Avis clients</span>
          <h2>Les Mots de Nos Hôtes</h2>
          <p class="subtitle">La confiance de ceux qui hanno choisi nos rituels de bien-être.</p>
        </div>
      </div>

      <div class="carousel-container">
        <div class="carousel-track">
          {duplicatedReviews.map((review) => (
            <div class="review-card">
              <div class="stars">
                {Array.from({ length: review.rating }).map(() => (
                  <span class="star">★</span>
                ))}
              </div>
              <p class="review-text">"{review.text}"</p>
              <div class="review-author">
                <strong>{review.name}</strong>
                <span class="google-badge">Avis Google</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <MobileActionBar lang="fr" />
</Layout>

<style>
  /* SFONDO BIANCO PURO PER LA PAGINA */
  main {
    background-color: #ffffff !important;
  }

  .page-header {
    padding: 5rem 0 3rem 0;
    text-align: center;
    background-color: transparent;
  }

  .sub-badge {
    display: inline-block;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 2px;
    color: var(--accent);
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .page-header h1 {
    font-size: clamp(2.5rem, 4vw, 3rem);
    margin-bottom: 0.5rem;
    color: #c4a724 !important;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .section {
    padding: 4rem 0 2rem 0;
    background-color: transparent;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: stretch;
  }

  .bio-content h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    color: #c4a724 !important;
  }

  .bio-content p {
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }

  .qualifiche-box {
    margin-top: 2.5rem;
    background-color: var(--accent-light);
    padding: 2.5rem;
    border-radius: 20px;
    border: none !important;
    box-shadow: none !important;
  }

  .qualifiche-box h3 {
    font-size: 1.2rem;
    margin-bottom: 1rem;
    color: var(--text-main);
  }

  .qualifiche-box ul {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--text-muted);
  }

  .qualifiche-box li {
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }

  .mission-card {
    position: relative;
    background-size: cover;
    background-position: center;
    color: #fff;
    padding: 3rem;
    border-radius: 20px;
    box-shadow: 0 20px 40px rgba(44, 42, 41, 0.06);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    min-height: 100%;
    border: none !important;
  }

  .mission-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(44, 42, 41, 0.55);
    z-index: 1;
  }

  .mission-content {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .mission-card h3 {
    color: #c4a724;
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .quote {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.6;
    margin-bottom: 0;
    color: #fcfbfa;
  }

  .reviews-section {
    padding: 3rem 0 6rem 0;
    background-color: transparent;
    overflow: hidden;
  }

  .reviews-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .reviews-header h2 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    color: #c4a724 !important;
  }

  .carousel-container {
    width: 100%;
    position: relative;
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
  }

  .carousel-track {
    display: flex;
    gap: 2.5rem;
    width: max-content;
    animation: scrollCarousel 35s linear infinite;
  }

  .carousel-container:hover .carousel-track {
    animation-play-state: paused;
  }

  @keyframes scrollCarousel {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - 1.25rem));
    }
  }

  .review-card {
    background-color: #faf8f5;
    padding: 2.5rem;
    border-radius: 20px;
    box-shadow: 0 20px 40px rgba(44, 42, 41, 0.04);
    width: 380px;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: none !important;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .review-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 25px 50px rgba(196, 167, 36, 0.12);
  }

  .stars {
    color: #c4a724;
    font-size: 1.2rem;
    letter-spacing: 2px;
    margin-bottom: 1rem;
  }

  .review-text {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .review-author {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(196, 167, 36, 0.15);
    padding-top: 1rem;
  }

  .review-author strong {
    color: var(--text-main);
    font-size: 0.95rem;
  }

  .google-badge {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 0.2rem;
  }

  @media (max-width: 900px) {
    .grid-2 {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .mission-card {
      min-height: 350px;
    }
    .review-card {
      width: 300px;
      padding: 2rem;
    }
    .carousel-track {
      animation-duration: 25s;
    }
  }
</style>