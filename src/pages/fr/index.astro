    line-height: 1.2;
    margin-bottom: 1.5rem;
    color: #ffffff;
    font-family: 'Outfit', sans-serif;
    min-height: calc(1.2 * 3em);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-text {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
    color: #e0e0e0;
    margin-bottom: 2.5rem;
    max-width: 650px;
    font-family: 'Montserrat', sans-serif;
  }

  .hero-buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    width: 100%;
  }

  .btn-primary {
    background-color: #c4a724;
    color: #fff;
