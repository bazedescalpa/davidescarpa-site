---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro'; 
import Footer from '../../components/Footer.astro';
import MobileActionBar from '../../components/MobileActionBar.astro';

import carosello1 from '../../assets/carosello1.webp';
import carosello2 from '../../assets/carosello2.webp';
import carosello3 from '../../assets/carosello3.webp';
import carosello4 from '../../assets/carosello4.webp';

import cagliariBg from '../../assets/cagliari.webp';
import villasimiusBg from '../../assets/villasimius.webp';
import shirodharaBg from '../../assets/shirodhara.webp';
import pindaswedaBg from '../../assets/pindasweda.webp';
import massaggiPersonalizzatiBg from '../../assets/massaggi_personalizzati.webp';
import quieteBg from '../../assets/quiete.webp';

const heroSlides = [
  {
    image: carosello1.src,
    title: "Massages Ayurvédiques à Cagliari",
  },
  {
    image: carosello2.src,
    title: "Soins ayurvédiques personnalisés",
  },
  {
    image: carosello3.src,
    title: "Votre rituel bien-être en Sardaigne",
  },
  {
    image: carosello4.src,
    title: "Massages à domicile à Villasimius",
  },
];
---

<Layout title="Ayuwellness | Luxe pour l'Esprit à Cagliari et Villasimius">
  <Header />

  <main>
    <!-- Sezione Hero con Carosello -->
    <section class="hero">
      {heroSlides.map((slide, index) => (
        <div 
          class={`hero-slide ${index === 0 ? 'active' : ''}`} 
          style={`background-image: url(${slide.image});`}
        >
          <div class="container hero-content">
            <h1>{slide.title}</h1>
            <p class="hero-text">
              Massages ayurvédiques personnalisés et soins holistiques pour retrouver l'équilibre entre le corps et l'esprit. À Cagliari en hiver et à Villasimius en été.
            </p>
            <div class="hero-buttons">
              <a href="/fr/massages" class="btn-primary btn-equal">Découvrir les massages</a>
              <a href="/fr/soins" class="btn-primary btn-equal">Découvrir les soins</a>
              <a href="https://wa.me/393270567128" target="_blank" rel="noopener noreferrer" class="btn-secondary">Réserver</a>
            </div>
          </div>
        </div>
      ))}
    </section>

    <!-- Sezione Presentazione / Studio con Sfondo Bianco, Testi scuri e link giallo -->
    <section class="section about-preview">
      <div class="container grid-2">
        <div class="about-text">
          <h2 class="section-title-gold">Une expérience de bien-être authentique</h2>
          <p>
            Le studio <strong>Ayuwellness</strong> offre un havre de paix à Cagliari, dédié à ceux qui souhaitent relâcher les tensions, éliminer les toxines et se régénérer grâce aux principes de l'ancienne tradition ayurvédique.
          </p>
          <p>
            Chaque parcours est conçu sur mesure en fonction de la constitution individuelle (doshas Vata, Pitta, Kapha), en combinant des huiles médicinales et des techniques de massage expertes.
          </p>
          <a href="/fr/a-propos" class="text-link">Rencontrer Federica Ennas &rarr;</a>
        </div>
        
        <!-- Cornice con Video HTML5 Nativo senza bagliore -->
        <div class="video-frame-container">
          <div class="video-glow-wrapper">
            <div class="video-frame">
              <video 
                id="native-video"
                autoplay 
                muted 
                playsinline 
                preload="auto">
                <source src="/video/ayurveda.mp4" type="video/mp4" />
                Votre navigateur ne prend pas en charge la balise vidéo.
              </video>
              <!-- Scudo protettivo totale che impedisce interazioni o click -->
              <div class="video-shield"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Testo stagionale con a capo iniziale e margine superiore -->
      <div class="container season-text-container">
        <p class="season-description">
          <br>Pendant la saison hivernale, les soins sont dispensés principalement au cœur de Cagliari, tandis qu'en période estivale, le service s'étend également à Villasimius, offrant une expérience de bien-être ayurvédique en totale harmonie avec les rythmes saisonniers et les besoins des visiteurs.
        </p>
      </div>

      <!-- Sotto: Due colonne con le card in alto e le descrizioni complete sotto -->
      <div class="container locations-grid-container">
        <div class="locations-grid">
          
          <!-- Colonna Cagliari -->
          <div class="location-column">
            <div class="location-card" style={`background-image: url(${cagliariBg.src});`}>
              <div class="location-overlay"></div>
              <div class="location-content">
                <h3>Cagliari</h3>
                <p>Le refuge de paix hivernal, où retrouver l'équilibre intérieur entre le rythme de la ville et le soin de soi.</p>
              </div>
            </div>
            <div class="location-description">
              <p>La santé et le bien-être occupent une place de plus en plus centrale, et pour répondre à ce besoin, Ayuwellness luxe pour l'esprit a ouvert son studio à Cagliari.</p>
              <p>L'Ayurvéda est un ancien système de médecine indienne basé sur l'équilibre entre l'esprit, le corps et l'âme, et les massages ayurvédiques représentent le moyen le plus naturel d'atteindre cette harmonie.</p>
              <p>Le studio situé Via Basilicata 61, dans le quartier de La Vega, propose un large éventail de soins personnalisés pour chaque besoin. Des techniques traditionnelles et des produits naturels sont utilisés pour réduire le stress, améliorer la circulation sanguine et soulager les douleurs articulaires.</p>
              <p>L'environnement accueillant et relaxant invite à s'immerger dans une expérience unique de bien-être ayurvédique. Tous les soins sont réalisés avec des huiles biologiques et des produits naturels pour garantir la plus haute qualité. Le studio collabore avec des B&B, des hôtels, des yachts et des structures touristiques, et est facilement accessible aux visiteurs de la capitale sarde.</p>
            </div>
          </div>

          <!-- Colonna Villasimius -->
          <div class="location-column">
            <div class="location-card" style={`background-image: url(${villasimiusBg.src});`}>
              <div class="location-overlay"></div>
              <div class="location-content">
                <h3>Villasimius</h3>
                <p>Le bien-être estival entre plages et détente, pour régénérer le corps et l'esprit pendant les vacances dans le sud de la Sardaigne.</p>
              </div>
            </div>
            <div class="location-description">
              <p>Le plaisir de recevoir un massage ayurvédique dans le confort de sa propre villa ou directement sur un yacht. Ayuwellness apporte le bien-être à domicile dans les zones de Villasimius, Solanas, Torre delle Stelle, Costa Rei, Muravera et Castiadas.</p>
              <p>À l'extérieur sous la lune ou dans une loggia aérée pendant la journée, chaque moment devient parfait pour s'offrir un soin régénérant.</p>
              <p>Le service est disponible sur réservation et nécessite un environnement calme, confortable et silencieux.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Sezione Trattamenti in Evidenza -->
    <section class="section bg-light">
      <div class="container text-center">
        <h2 class="section-title-gold">Rituels Ayurvédiques</h2>
        <p class="section-subtitle">Du Shirodhara au Pindasweda : des soins ciblés pour chaque besoin.</p>
        
        <div class="cards-grid">
          <a href="/fr/massages" class="service-card service-card-image" style={`background-image: url(${shirodharaBg.src}); text-decoration: none;`}>
            <div class="service-card-overlay"></div>
            <div class="service-card-content">
              <h3>Shirodhara</h3>
              <p>Le flux constant d'huile tiède sur le front pour apaiser profondément l'esprit et le système nerveux.</p>
            </div>
          </a>
          <a href="/fr/massages" class="service-card service-card-image" style={`background-image: url(${pindaswedaBg.src}); text-decoration: none;`}>
            <div class="service-card-overlay"></div>
            <div class="service-card-content">
              <h3>Pindasweda</h3>
              <p>Massage aux pochons chauds d'herbes médicinales, idéal pour dénouer les tensions et purifier.</p>
            </div>
          </a>
          <a href="/fr/massages" class="service-card service-card-image" style={`background-image: url(${massaggiPersonalizzatiBg.src}); text-decoration: none;`}>
            <div class="service-card-overlay"></div>
            <div class="service-card-content">
              <h3>Massages Personnalisés</h3>
              <p>Rituels sur mesure basés sur l'écoute de la personne et l'harmonisation des doshas.</p>
            </div>
          </a>
        </div>

        <div class="action-buttons-container">
          <a href="/fr/massages" class="btn-primary btn-equal">Explorer le menu complet des massages</a>
          <a href="/fr/soins" class="btn-primary btn-equal">Explorer le menu complet des soins</a>
        </div>
      </div>
    </section>

    <!-- Sezione Eventi / L'angolo della coccola -->
    <section class="section">
      <div class="container grid-2 align-center">
        <div>
          <span class="sub-badge">Pour vos événements spéciaux</span>
          <h2 class="section-title-gold" style="text-align: left;">Le coin cocooning</h2>
          <p>
            Rendez vos mariages, anniversaires ou fêtes privées inoubliables. Offrez à vos invités un moment de détente exclusif de 10 minutes dédié aux mains ou aux pieds avec des huiles naturelles et une serviette chaude.
          </p>
          <a href="https://wa.me/393270567128?text=Bonjour,%20je%20souhaite%20des%20informations%20ou%20réserver%20un%20événement%20avec%20Le%20coin%20cocooning." target="_blank" rel="noopener noreferrer" class="btn-primary" style="margin-top: 1.5rem; display: inline-block;">Réserver un événement</a>
        </div>
        <div class="highlight-box" style={`background-image: url(${quieteBg.src});`}>
          <div class="highlight-overlay"></div>
          <p class="quote">"Le véritable luxe n'est pas matériel : c'est prendre soin de soi et s'offrir un espace de pure quiétude."</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <MobileActionBar lang="fr" />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.hero-slide');
    if (slides.length > 0) {
      let currentIndex = 0;
      const intervalTime = 5000;

      function nextSlide() {
        slides[currentIndex].classList.remove('active');
        currentIndex = (currentIndex + 1) % slides.length;
        slides[currentIndex].classList.add('active');
      }

      setInterval(nextSlide, intervalTime);
    }

    const video = document.getElementById('native-video') as HTMLVideoElement;
    if (video) {
      video.currentTime = 3;

      video.addEventListener('timeupdate', () => {
        if (video.currentTime >= 9.0) {
          video.currentTime = 3;
          video.play();
        }
      });
    }
  });
</script>

<style>
  .quote {
    font-family: 'Outfit', sans-serif;
    font-style: normal;
  }

  .hero {
    position: relative;
    width: 100%;
    min-height: 550px;
