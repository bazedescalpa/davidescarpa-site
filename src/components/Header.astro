---
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.webp';
import LanguagePicker from './LanguagePicker.astro';
import { useTranslations } from '../i18n/ui';

// Rileva la lingua corrente (default 'it') e inizializza il dizionario
const lang = Astro.currentLocale || 'it';
const t = useTranslations(lang as any);

// Calcola il prefisso della lingua per costruire i link corretti (es. /en, /de, /fr o vuoto per IT)
const prefix = lang === 'it' ? '' : `/${lang}`;

// Array dei link di navigazione con percorsi localizzati e corretti per ogni lingua
const uniqueNavLinks = [
  { 
    name: t('nav.home'), 
    href: prefix === '' ? '/' : `${prefix}/` 
  },
  { 
    name: t('nav.chi-sono'), 
    href: prefix === '' ? '/chi-sono' : `${prefix}/${lang === 'de' ? 'ueber-mich' : lang === 'fr' ? 'a-propos' : 'about'}` 
  },
  { 
    name: t('nav.massaggi') || 'Massaggi', 
    href: prefix === '' ? '/massaggi' : `${prefix}/${lang === 'de' ? 'massagen' : 'massages'}` 
  },
  { 
    name: t('nav.trattamenti'), 
    href: prefix === '' ? '/trattamenti' : `${prefix}/${lang === 'de' ? 'behandlungen' : lang === 'fr' ? 'soins' : 'treatments'}` 
  },
  { 
    name: t('nav.gallery'), 
    href: prefix === '' ? '/gallery' : `${prefix}/${lang === 'de' || lang === 'fr' ? 'galerie' : 'gallery'}` 
  },
  { 
    name: t('nav.blog'), 
    href: prefix === '' ? '/blog' : `${prefix}/blog` 
  },
  { 
    name: t('nav.contatti'), 
    href: prefix === '' ? '/contatti' : `${prefix}/${lang === 'de' ? 'kontakt' : 'contact'}` 
  },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header" id="site-header">
  <!-- Top bar: Telefono a sinistra, Logo al centro, Social + Language Picker a destra -->
  <div class="container header-top">
    <!-- Sinistra: Telefono -->
    <div class="header-left">
      <a href="tel:+393270567128" class="phone-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        <span>+39 327 056 7128</span>
      </a>
    </div>

    <!-- Centro: Logo -->
    <div class="header-center">
      <a href={prefix === '' ? '/' : `${prefix}/`} class="logo-link">
        <Image 
          src={logoImage} 
          alt="Ayuwellness Lusso per la Mente" 
          width={280} 
          format="webp" 
          quality={90}
        />
      </a>
    </div>

    <!-- Destra: Social, Selettore Lingua e Menu Toggle per mobile -->
    <div class="header-right">
      <div class="header-actions-desktop">
        <LanguagePicker />
        <div class="social-icons">
          <!-- Facebook -->
          <a href="https://www.facebook.com/AyuWellnessLussoperlamente" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.477 2 2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12c0-5.523-4.477-10-10-10z"/>
            </svg>
          </a>
          <!-- Instagram -->
          <a href="https://www.instagram.com/ayuwellness_lusso_per_la_mente/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <!-- WhatsApp -->
          <a href="https://wa.me/393270567128" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
              <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Pulsante Menu Mobile -->
      <button id="menu-toggle" class="menu-toggle" aria-label="Apri menu">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>

  <!-- Sotto: Navigazione Desktop -->
  <div class="header-bottom">
    <div class="container">
      <nav class="desktop-nav">
        <ul>
          {uniqueNavLinks.map((link) => {
            const isHome = link.href === '/' || link.href === '/en/' || link.href === '/de/' || link.href === '/fr/';
            const isActive = isHome 
              ? currentPath === link.href 
              : currentPath === link.href || currentPath.startsWith(link.href + '/');

            return (
              <li>
                <a href={link.href} class={isActive ? "active" : ""}>{link.name}</a>
              </li>
            );
          })}
        </ul>
      </nav>
    </div>
  </div>

  <!-- Menu Mobile Overlay -->
  <div id="mobile-menu" class="mobile-menu">
    <div class="mobile-lang-container">
      <LanguagePicker />
    </div>
    <nav>
      <ul>
        {uniqueNavLinks.map((link) => {
          const isHome = link.href === '/' || link.href === '/en/' || link.href === '/de/' || link.href === '/fr/';
          const isActive = isHome 
            ? currentPath === link.href 
            : currentPath === link.href || currentPath.startsWith(link.href + '/');

          return (
            <li>
              <a href={link.href} class={`mobile-link ${isActive ? "active" : ""}`}>{link.name}</a>
            </li>
          );
        })}
      </ul>
      <div class="mobile-cta-container">
        <a href="tel:+393270567128" class="btn-primary">{t('btn.chiama')}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const header = document.getElementById('site-header');

  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('is-open');
      menuToggle.classList.toggle('is-active');
    });
  }

  let lastScrollY = window.scrollY;
  let ticking = false;

  window.addEventListener('scroll', () => {
    lastScrollY = window.scrollY;
    if (!ticking) {
      window.requestAnimationFrame(() => {
        if (lastScrollY > 150) {
          header?.classList.add('scrolled');
        } 
        else if (lastScrollY < 250) {
          header?.classList.remove('scrolled');
        }
        ticking = false;
      });
      ticking = true;
    }
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background-color: #242424;
    border-bottom: 1px solid #333;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    font-family: 'Montserrat', sans-serif;
    will-change: transform;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    padding-bottom: 1rem;
    background-color: #242424;
    transition: padding 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .header-left, .header-right {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .header-right {
    justify-content: flex-end;
  }

  .header-actions-desktop {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .header-center {
    flex: 1;
    text-align: center;
    display: flex;
    justify-content: center;
  }

  .phone-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 700;
    font-family: 'Montserrat', sans-serif;
    transition: color 0.2s;
  }

  .phone-link svg {
    stroke: #ffffff;
    width: 20px;
    height: 20px;
  }

  .phone-link:hover {
    color: #c4a724;
  }

  .logo-link {
    display: inline-block;
  }

  .logo-link img {
    height: auto;
    max-height: 128px; 
    width: auto;
    display: block;
    transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .social-icons {
    display: flex;
    gap: 1.2rem;
    align-items: center;
  }

  .social-icons a {
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
  }

  .social-icons a svg {
    width: 20px;
    height: 20px;
  }

  .social-icons a:hover {
    color: #c4a724;
  }

  .header-bottom {
    border-top: 1px solid #333;
    background-color: #000000;
    display: block;
  }

  .desktop-nav ul {
    display: flex;
    justify-content: center;
    list-style: none;
    gap: 2.5rem;
    margin: 0;
    padding: 0.75rem 0;
  }

  .desktop-nav a {
    text-decoration: none;
    color: #ffffff;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.5px;
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    font-family: 'Montserrat', sans-serif;
    transition: background-color 0.15s ease, transform 0.15s ease, color 0.2s ease, box-shadow 0.15s ease;
    display: inline-block;
  }

  .desktop-nav a:hover {
    background-color: rgba(196, 167, 36, 0.12);
    color: #c4a724;
    transform: translateY(1px);
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.6), 0 0 8px rgba(196, 167, 36, 0.15);
  }

  .desktop-nav a.active {
    color: #c4a724;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    flex-direction: column;
    gap: 6px;
    padding: 5px;
  }

  .menu-toggle .bar {
    display: block;
    width: 28px;
    height: 2px;
    background-color: #ffffff;
    transition: all 0.3s ease;
  }

  .mobile-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background-color: #1a1a1a;
    border-bottom: 1px solid #333;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 10px 15px -3px rgba(0,0,0,0.5);
  }

  .mobile-menu.is-open {
    display: block;
  }

  .mobile-lang-container {
    display: flex;
    justify-content: center;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .mobile-menu ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: center;
  }

  .mobile-link {
    text-decoration: none;
    font-family: 'Montserrat', sans-serif;
    font-size: 1.05rem;
    color: #ffffff;
    font-weight: 700;
    display: inline-block;
    padding: 0.35rem 0.8rem;
    border-radius: 4px;
    transition: background-color 0.15s ease, color 0.2s ease;
  }

  .mobile-link:hover {
    background-color: rgba(196, 167, 36, 0.12);
    color: #c4a724;
  }

  .mobile-link.active {
    color: #c4a724;
  }

  .mobile-cta-container {
    text-align: center;
  }

  .btn-primary {
    display: inline-block;
    background-color: #c4a724;
    color: #fff;
    text-decoration: none;
    padding: 0.65rem 1.8rem;
    border-radius: 4px;
    font-weight: 700;
    font-family: 'Montserrat', sans-serif;
  }

  .site-header.scrolled .header-top {
    padding-top: 0.4rem;
    padding-bottom: 0.4rem;
  }

  .site-header.scrolled .logo-link img {
    max-height: 65px; 
  }

  @media (max-width: 900px) {
    .header-bottom {
      display: none;
    }
    .header-actions-desktop {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
    .header-left {
      visibility: hidden;
    }
    .header-center {
      justify-content: center;
    }
    .logo-link img {
      max-height: 65px; 
    }

    .site-header.scrolled .logo-link img {
      max-height: 48px; 
    }

    .site-header.scrolled .header-top {
      padding-top: 0.3rem;
      padding-bottom: 0.3rem;
    }
  }
</style>