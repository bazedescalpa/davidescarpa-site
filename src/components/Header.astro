---
// src/components/Header.astro
---

<header class="fixed top-4 left-4 right-4 z-50">
  <div class="max-w-7xl mx-auto backdrop-blur-md bg-slate-950/70 border border-slate-800/80 rounded-2xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.5)]">
    <div class="px-6 md:px-12 h-20 flex items-center justify-between">
      
      <!-- Logo SVG -->
      <a href="/" class="flex items-center h-10 transition-opacity hover:opacity-90">
        <img 
          src="/Logo-Scritta.svg" 
          alt="Davide Scarpa Soluzioni Web Logo" 
          class="h-full w-auto object-contain"
          loading="eager"
        />
      </a>

      <!-- Navigazione Desktop -->
      <nav class="hidden md:flex items-center gap-8">
        <a href="/#servizi" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Servizi</a>
        <a href="/#progetti" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Progetti</a>
        <a href="/blog" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Blog</a>
        <a href="/#contatti" class="px-4 py-2 bg-slate-900 border border-slate-800 hover:border-cyan-500/30 hover:text-cyan-400 text-sm font-semibold rounded-xl transition-all duration-200">
          Inizia il tuo progetto
        </a>
      </nav>

      <!-- Pulsante Menu Mobile -->
      <button id="menu-toggle" class="md:hidden text-slate-400 hover:text-white focus:outline-none" aria-label="Apri menu">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Menu Mobile a Scomparsa (stondato anch'esso) -->
  <div id="mobile-menu" class="hidden md:hidden mt-2 border border-slate-800/80 bg-slate-950/95 backdrop-blur-lg rounded-2xl mx-4 px-6 py-6 space-y-4">
    <a href="/#servizi" class="block text-base font-medium text-slate-300 hover:text-white transition-colors">Servizi</a>
    <a href="/#progetti" class="block text-base font-medium text-slate-300 hover:text-white transition-colors">Progetti</a>
    <a href="/blog" class="block text-base font-medium text-slate-300 hover:text-white transition-colors">Blog</a>
    <a href="/#contatti" class="block text-center px-4 py-3 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold rounded-xl transition-colors">
      Inizia il tuo progetto
    </a>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }
</script>