---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="relative w-screen left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] bg-slate-950 text-slate-400 border-t border-slate-900/60 py-16 m-0 p-0">
  <div class="max-w-7xl mx-auto px-6 md:px-12 grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
    
    <!-- Info Principali con Logo -->
    <div class="space-y-4">
      <div class="flex items-center h-10">
        <img 
          src="/Logo-Scritta.svg" 
          alt="Davide Scarpa Soluzioni Web Logo" 
          class="h-full w-auto object-contain"
          loading="lazy"
        />
      </div>
      <p class="text-sm text-slate-500 leading-relaxed max-w-xs">
        Soluzioni web e mobile su misura. Progettazione di architetture veloci, scalabili e ottimizzate per i motori di ricerca.
      </p>
    </div>

    <!-- Link Rapidi -->
    <div class="space-y-4">
      <h4 class="text-sm font-semibold uppercase tracking-wider text-white">Link Rapidi</h4>
      <ul class="space-y-2.5 text-sm">
        <li><a href="/#servizi" class="hover:text-cyan-400 transition-colors">Servizi</a></li>
        <li><a href="/#progetti" class="hover:text-cyan-400 transition-colors">Progetti</a></li>
        <li><a href="/blog" class="hover:text-cyan-400 transition-colors">Blog</a></li>
      </ul>
    </div>

    <!-- Contatti & Social -->
    <div class="space-y-4">
      <h4 class="text-sm font-semibold uppercase tracking-wider text-white">Contatti</h4>
      <ul class="space-y-2.5 text-sm">
        <li>
          <a href="mailto:info@davidescarpa.com" class="hover:text-cyan-400 transition-colors">
            info@davidescarpa.com
          </a>
        </li>
        <li class="text-slate-500 font-mono text-xs pt-2">
          Cagliari, Sardegna, Italia
        </li>
      </ul>
    </div>

  </div>

  <!-- Copyright Inferiore -->
  <div class="max-w-7xl mx-auto px-6 md:px-12 pt-8 border-t border-slate-900/40 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-600 font-mono">
    <!-- Blocco Copyright con Logo.svg inline -->
    <div class="flex items-center gap-2">
      <span>&copy; {currentYear}</span>
      <img 
        src="/logo-ds.svg" 
        alt="Logo" 
        class="h-5 w-auto object-contain" 
        loading="lazy"
      />
      <span>Davide Scarpa - Soluzioni Web. Tutti i diritti riservati.</span>
    </div>
  </div>
</footer>