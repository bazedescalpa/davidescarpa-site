---
// src/layouts/Layout.astro
import '../styles/global.css';
import Header from '../components/Header.astro'; 
import Footer from '../components/Footer.astro'; 

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="it" class="scroll-smooth m-0 p-0">
	<head>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-FP34E3GSXS"></script>
		<script>
 			window.dataLayer = window.dataLayer || [];
 			function gtag(){dataLayer.push(arguments);}
 			gtag('js', new Date());

 			gtag('config', 'G-FP34E3GSXS');
		</script>
		<meta charset="UTF-8" />
		<meta name="description" content="Davide Scarpa - Soluzioni Web professionali. Sviluppo siti web, web app e applicazioni mobile su misura." />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" sizes="512x512">
		<title>{title}</title>
		
		<!-- Pre-impostazione colore di sfondo -->
		<style is:inline>
			html { background-color: #020617; }
		</style>
	</head>

<body class="bg-transparent text-slate-100 antialiased min-h-screen m-0 p-0 overflow-x-hidden selection:bg-cyan-500 selection:text-slate-950">
    
    <!-- Sfondo FISSO globale -->
    <div class="fixed inset-0 -z-50 w-full h-full overflow-hidden bg-slate-950">
        <img 
            src="/sfondotech.webp" 
            alt="Sfondo tecnologico" 
            class="parallax-bg absolute inset-0 w-full h-[130vh] object-cover object-top transition-transform duration-[50ms] ease-out" 
        />
        <!-- Overlay scuro -->
        <div class="absolute inset-0 bg-slate-950/80"></div>
    </div>

    <Header />

    <main class="w-full relative">
        <slot />
    </main>

    <Footer />

    <!-- Pulsante di contatto mobile fluttuante -->
    <div class="fixed bottom-6 right-6 z-50 md:hidden">
        <a href="mailto:info@davidescarpa.com?subject=Richiesta%20Informazioni" 
           class="flex items-center gap-2 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold px-5 py-3 rounded-xl shadow-lg shadow-cyan-500/20 transition-all duration-200 active:scale-95">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <span>Chiedi Info</span>
        </a>
    </div>

    <script>
        window.addEventListener('scroll', () => {
            const scrolled = window.scrollY;
            const bg = document.querySelector('.parallax-bg') as HTMLElement;
            if (bg) {
                const yOffset = scrolled * 0.1;
                bg.style.transform = `translate3d(0, -${yOffset}px, 0)`;
            }
        }, { passive: true });
    </script>
</body>

</html>

<style is:global>
	:root {
		font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
	}
</style>